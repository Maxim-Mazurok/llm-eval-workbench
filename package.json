{
  "name": "llm-eval-workbench",
  "version": "0.1.0",
  "description": "A local LLM evaluation workbench for OpenAI-compatible chat completion endpoints, with built-in benchmarks and optional pluggable benchmark packs.",
  "keywords": [
    "llm-evaluation",
    "benchmark",
    "eval",
    "humaneval",
    "bbeh",
    "openai-compatible",
    "react",
    "vite"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maxim-Mazurok/llm-eval-workbench.git"
  },
  "bugs": {
    "url": "https://github.com/Maxim-Mazurok/llm-eval-workbench/issues"
  },
  "homepage": "https://github.com/Maxim-Mazurok/llm-eval-workbench#readme",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names frontend,backend --prefix-colors cyan,green \"npm run dev:frontend\" \"npm run dev:bench\"",
    "dev:frontend": "node scripts/start-frontend.mjs",
    "dev:bench": "node scripts/eval-server.mjs",
    "migrate:output-extraction": "node scripts/update-saved-results.mjs --apply",
    "migrate:loop-detection": "node scripts/migrate-loop-detection.mjs",
    "migrate:providers": "node scripts/migrate-provider-configs.mjs",
    "reanalyze:output-extraction": "node scripts/reprocess-saved-results.mjs",
    "test": "vitest run",
    "test:unit": "vitest run src/notifications.test.ts",
    "test:integration": "vitest run src/App.integration.test.tsx",
    "test:e2e": "playwright test",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "lucide-react": "^0.555.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "vite": "^7.2.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "optionalDependencies": {
    "@github/keytar": "^7.10.6"
  }
}
